[Unit]
Description=Watch Codex and T3 Code events for Agents Alert
After=default.target

[Service]
Type=simple
ExecStart=%h/.local/bin/codex-alert-failure-watch
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
LockPersonality=true
MemoryHigh=128M
MemoryMax=256M
CPUQuota=25%
TasksMax=64

[Install]
WantedBy=default.target
