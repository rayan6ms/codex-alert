NOTIFIER = Path.home() / ".local/bin/codex-notify-stop"
DB_FILE = STATE_DIR / "failure-watch.sqlite3"
LOCK_FILE = STATE_DIR / "failure-watch.lock"
STATUS_FILE = STATE_DIR / "failure-watch-status.json"
LOG_FILE = STATE_DIR / "failure-watch.log"
MAX_LOG_BYTES = 1024 * 1024
MAX_RELEVANT_RECORD_BYTES = 8 * 1024 * 1024
RECONCILE_SECONDS = 60
ACCOUNT_RESCAN_SECONDS = 5 * 60
T3_POLL_SECONDS = 2
T3_BATCH_SIZE = 1000
STARTED_AT = time.time()
INPUT_TOOLS = {
    "request_user_input",
    "request_user_input_async",
    "send_message_to_user_async",
}
ROLLOUT_MARKERS = (
    b"session_meta", b"turn_context", b"task_complete",
    *(name.encode("ascii") for name in sorted(INPUT_TOOLS)),
)

IN_MODIFY = 0x00000002
IN_CLOSE_WRITE = 0x00000008
IN_MOVED_TO = 0x00000080
IN_CREATE = 0x00000100
IN_DELETE_SELF = 0x00000400
IN_MOVE_SELF = 0x00000800
IN_Q_OVERFLOW = 0x00004000
IN_IGNORED = 0x00008000
IN_ISDIR = 0x40000000
WATCH_MASK = (
    IN_MODIFY
    | IN_CLOSE_WRITE
    | IN_MOVED_TO
    | IN_CREATE
    | IN_DELETE_SELF
    | IN_MOVE_SELF
)
EVENT_HEADER = struct.Struct("iIII")


def live_timestamp(value):
    if not isinstance(value, str):
        return False
    try:
        stamp = datetime.fromisoformat(value.replace("Z", "+00:00")).timestamp()
        return stamp >= STARTED_AT and time.time() - stamp < 120
    except (OSError, OverflowError, ValueError):
        return False


def clean_environment():
    environment = os.environ.copy()
    for key in ("LD_LIBRARY_PATH", "LD_PRELOAD", "LD_AUDIT", "LD_DEBUG"):
        environment.pop(key, None)
    return environment


def compact(value, limit=1200):
    text = str(value or "").strip()
    return text if len(text) <= limit else text[: limit - 1] + "…"


def log(**record):
    try:
        STATE_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
        if LOG_FILE.exists() and LOG_FILE.stat().st_size >= MAX_LOG_BYTES:
            previous = LOG_FILE.with_suffix(LOG_FILE.suffix + ".1")
            previous.unlink(missing_ok=True)
            LOG_FILE.replace(previous)
        record["time"] = datetime.now().astimezone().isoformat(timespec="seconds")
        with LOG_FILE.open("a", encoding="utf-8") as stream:
            stream.write(json.dumps(record, ensure_ascii=False) + "\n")
    except OSError:
        pass


def save_status(**changes):
    try:
        current = {}
        try:
            value = json.loads(STATUS_FILE.read_text(encoding="utf-8"))
            current = value if isinstance(value, dict) else {}
        except (OSError, ValueError):
            pass
        current.update(changes)
        current["updated_at"] = time.time()
        atomic_json(STATUS_FILE, current)
    except OSError:
        pass


def connect_db(path=DB_FILE):
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    connection = sqlite3.connect(path, timeout=5)
    connection.row_factory = sqlite3.Row
    connection.execute("PRAGMA busy_timeout=5000")
    connection.execute("PRAGMA journal_mode=WAL")
    connection.execute("PRAGMA synchronous=NORMAL")
    connection.execute(
        """
        CREATE TABLE IF NOT EXISTS metadata (
            key TEXT PRIMARY KEY,
            value TEXT NOT NULL
        )
        """
    )
    connection.execute(
        """
        CREATE TABLE IF NOT EXISTS rollout_files (
            path TEXT PRIMARY KEY,
            device INTEGER NOT NULL,
            inode INTEGER NOT NULL,
            offset INTEGER NOT NULL,
            account TEXT NOT NULL,
            session_id TEXT NOT NULL DEFAULT '',
            cwd TEXT NOT NULL DEFAULT '',
            originator TEXT NOT NULL DEFAULT '',
            source_json TEXT NOT NULL DEFAULT 'null',
            thread_source TEXT NOT NULL DEFAULT '',
            history_mode TEXT NOT NULL DEFAULT '',
            model TEXT NOT NULL DEFAULT '',
            model_turn_id TEXT NOT NULL DEFAULT '',
            updated_at REAL NOT NULL
        )
        """
    )
    connection.commit()
    try:
        path.chmod(0o600)
    except OSError:
        pass
    return connection


def account_name(home):
    return home.name.lstrip(".") or "codex"


def session_roots(homes=None):
    """Return each physical sessions tree once, even for shadow homes."""
    roots = {}
    for home in codex_homes() if homes is None else homes:
        sessions = home / "sessions"
        try:
            resolved = sessions.resolve(strict=True)
            status = resolved.stat()
        except OSError:
            continue
        identity = (status.st_dev, status.st_ino)
        roots.setdefault(identity, (resolved, account_name(home)))
    return sorted(roots.values(), key=lambda item: str(item[0]))


def rollout_files(roots):
    for root, account in roots:
        try:
            for directory, _, filenames in os.walk(root):
                base = Path(directory)
                for filename in filenames:
                    if filename.endswith(".jsonl"):
                        yield base / filename, account
        except OSError:
            continue


def fresh_context(path, account, status, offset=0):
    return {
        "path": str(path),
        "device": status.st_dev,
        "inode": status.st_ino,
        "offset": offset,
        "account": account,
        "session_id": "",
        "cwd": "",
        "originator": "",
        "source_json": "null",
        "thread_source": "",
        "history_mode": "",
        "model": "",
        "model_turn_id": "",
        "updated_at": time.time(),
    }


def context_from_row(row):
    return dict(row)


def save_context(connection, context):
    context["updated_at"] = time.time()
    connection.execute(
        """
        INSERT INTO rollout_files (
            path, device, inode, offset, account, session_id, cwd,
            originator, source_json, thread_source, history_mode, model,
            model_turn_id, updated_at
        ) VALUES (
            :path, :device, :inode, :offset, :account, :session_id, :cwd,
            :originator, :source_json, :thread_source, :history_mode, :model,
            :model_turn_id, :updated_at
        )
        ON CONFLICT(path) DO UPDATE SET
            device=excluded.device,
            inode=excluded.inode,
            offset=excluded.offset,
            account=excluded.account,
            session_id=excluded.session_id,
            cwd=excluded.cwd,
            originator=excluded.originator,
            source_json=excluded.source_json,
            thread_source=excluded.thread_source,
            history_mode=excluded.history_mode,
            model=excluded.model,
            model_turn_id=excluded.model_turn_id,
            updated_at=excluded.updated_at
        """,
        context,
    )


def source_value(context):
    try:
        return json.loads(context.get("source_json") or "null")
    except ValueError:
        return None


def ignored_session(context):
    source = source_value(context)
    if context.get("thread_source") == "subagent":
        return True
    if isinstance(source, dict) and "subagent" in source:
        return True
    # Ephemeral execs do not normally create rollout files. Keep these guards
    # for forward compatibility if Codex starts persisting explicit metadata.
    if context.get("history_mode") in ("ephemeral", "transient", "disabled"):
        return True
    if source == "ephemeral":
        return True
    return False


def account_for_session(session_id, fallback, state_db=None, settings_file=None):
    """Resolve T3's provider instance when shadow homes share one log tree."""
    match = t3_codex_session(
        session_id,
        current_db=T3_CURRENT_DB if state_db is None else None,
        legacy_db=T3_LEGACY_DB if state_db is None else Path(state_db),
    )
    return t3_account(match[1], fallback, settings_file or T3_SETTINGS_FILE) if match else fallback


def error_message(error):
    if isinstance(error, dict):
        message = error.get("message") or error.get("additional_details")
        if message:
            return compact(message)
        return compact(json.dumps(error, ensure_ascii=False, separators=(",", ":")))
    return compact(error)


def question_message(questions):
    if not isinstance(questions, list):
        return ""
    return compact("\n".join(
        str(question.get("question") or question.get("title") or "")
        for question in questions if isinstance(question, dict)
    ))


def handle_record(context, row, dispatch):
    """Update rollout context and forward input requests or terminal failures."""
    if not isinstance(row, dict):
        return True
    payload = row.get("payload")
    if not isinstance(payload, dict):
        return True

    row_type = row.get("type")
    if row_type == "session_meta":
        context["session_id"] = str(
            payload.get("session_id") or payload.get("id") or context["session_id"]
        )
        context["cwd"] = str(payload.get("cwd") or context["cwd"])
        context["originator"] = str(payload.get("originator") or "")
        context["source_json"] = json.dumps(
            payload.get("source"), ensure_ascii=False, separators=(",", ":")
        )
        context["thread_source"] = str(payload.get("thread_source") or "")
        context["history_mode"] = str(payload.get("history_mode") or "")
        return True

    if row_type == "turn_context":
        context["cwd"] = str(payload.get("cwd") or context["cwd"])
        context["model"] = str(payload.get("model") or context["model"])
        context["model_turn_id"] = str(payload.get("turn_id") or "")
        return True

    kind = payload.get("type")
    name = payload.get("name")
    alert = {}
    if (
        row_type == "response_item" and kind == "function_call"
        and isinstance(name, str) and name in INPUT_TOOLS
    ):
        arguments = payload.get("arguments")
        try:
            if isinstance(arguments, str):
                arguments = json.loads(arguments)
        except ValueError:
            return True
        if not isinstance(arguments, dict) or not payload.get("call_id"):
            return True
        if name == "send_message_to_user_async":
            message = compact(arguments.get("message"))
        else:
            questions = arguments.get("questions")
            if not isinstance(questions, list) or not questions:
                return True
            message = question_message(questions)
        turn_id = context.get("model_turn_id", "")
        alert = {
            "request_id": payload["call_id"],
            "input_message": message or "Codex needs your input.",
        }
    elif row_type == "event_msg" and kind == "task_complete":
        status = payload.get("status")
        error = payload.get("error")
        if status in ("interrupted", "cancelled", "canceled") or (not error and status != "failed"):
            return True
        turn_id = str(payload.get("turn_id") or "").strip()
        if not turn_id:
            log(event="failure-missing-identity", path=context.get("path"))
            return True
        alert = {"error": error_message(error) or "The Codex task failed."}
    else:
        return True

    session_id = str(context.get("session_id") or "").strip()
    if not session_id or ignored_session(context):
        return True

    model = context.get("model") if context.get("model_turn_id") == turn_id else ""
    alert.update({
        "session_id": session_id,
        "turn_id": turn_id,
        "cwd": context.get("cwd") or "",
        "model": model,
    })
    account = context.get("account") or "codex"
    if context.get("originator") in ("t3code_desktop", "T3 Code"):
        account = account_for_session(session_id, account)
    return bool(dispatch(alert, account))


def dispatch_failure(payload, account):
    waiting_input = bool(payload.get("request_id"))
    outcome = "input" if waiting_input else "failure"
    option = "--waiting-input" if waiting_input else "--failure"
    environment = clean_environment()
    environment.pop("CODEX_HOME", None)
    try:
        result = subprocess.run(
            [str(NOTIFIER), option, "--account", account],
            input=json.dumps(payload, ensure_ascii=False),
            text=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            env=environment,
            check=False,
            timeout=8,
        )
        if result.returncode == 0:
            log(
                event=f"{outcome}-forwarded",
                account=account,
                session_id=payload.get("session_id"),
                turn_id=payload.get("turn_id"),
            )
            save_status(
                **{f"last_{outcome}_at": time.time()},
                last_session_id=payload.get("session_id"),
                last_turn_id=payload.get("turn_id"),
                last_error="",
            )
            return True
        log(event=f"{outcome}-forward-failed", returncode=result.returncode,
            error=compact(result.stderr, 500))
    except (OSError, subprocess.SubprocessError) as exc:
        log(event=f"{outcome}-forward-failed", error=repr(exc))
    save_status(last_error=f"Could not forward a Codex {outcome} notification")
    return False


def load_context(connection, path):
    row = connection.execute(
        "SELECT * FROM rollout_files WHERE path = ?", (str(path),)
    ).fetchone()
    return context_from_row(row) if row is not None else None


def read_first_record(path):
    try:
        with path.open("rb") as stream:
            raw = stream.readline()
        return json.loads(raw) if raw.endswith(b"\n") else None
    except (OSError, ValueError):
        return None


def baseline_file(connection, path, account):
    try:
        status = path.stat()
    except OSError:
        return False
    context = fresh_context(path, account, status, status.st_size)
    first = read_first_record(path)
    if first is not None:
        handle_record(context, first, lambda _payload, _account: True)
    save_context(connection, context)
    return True


def process_file(connection, path, account, dispatch=dispatch_failure):
    """Consume complete records appended after the durable file offset."""
    path = Path(path).resolve(strict=False)
    try:
        status = path.stat()
        if not path.is_file():
            return False
    except OSError:
        return False

    context = load_context(connection, path)
    if context is not None and (
        context["device"] != status.st_dev or context["inode"] != status.st_ino
        or status.st_size < context["offset"]
    ):
        baseline_file(connection, path, account)
        connection.commit()
        return True
    if (
        context is None
        or context["device"] != status.st_dev
        or context["inode"] != status.st_ino
        or status.st_size < context["offset"]
    ):
        context = fresh_context(path, account, status)
    else:
        context["account"] = account

    committed = int(context["offset"])
    changed = False
    try:
        with path.open("rb") as stream:
            opened = os.fstat(stream.fileno())
            if (opened.st_dev, opened.st_ino) != (status.st_dev, status.st_ino):
                return False
            stream.seek(committed)
            while True:
                start = stream.tell()
                raw = stream.readline(MAX_RELEVANT_RECORD_BYTES + 1)
                if not raw:
                    break
                if len(raw) > MAX_RELEVANT_RECORD_BYTES:
                    while raw and not raw.endswith(b"\n"):
                        raw = stream.readline(MAX_RELEVANT_RECORD_BYTES + 1)
                    committed = stream.tell()
                    changed = True
                    continue
                if not raw.endswith(b"\n"):
                    break
                # Skip model content and tool traffic unrelated to alerts.
                if not any(marker in raw for marker in ROLLOUT_MARKERS):
                    committed = stream.tell()
                    changed = True
                    continue
                try:
                    row = json.loads(raw)
                except (UnicodeDecodeError, ValueError):
                    log(event="invalid-rollout-record", path=str(path), offset=start)
                    committed = stream.tell()
                    changed = True
                    continue
                if not isinstance(row, dict):
                    committed = stream.tell()
                    changed = True
                    continue
                deliver = (
                    dispatch if live_timestamp(row.get("timestamp"))
                    else lambda _payload, _account: True
                )
                if not handle_record(context, row, deliver):
                    break
                committed = stream.tell()
                changed = True
    except OSError as exc:
        log(event="rollout-read-failed", path=str(path), error=repr(exc))
        return False

    context["offset"] = committed
    if changed or load_context(connection, path) is None:
        save_context(connection, context)
        connection.commit()
    return changed


def initialized(connection):
    row = connection.execute(
        "SELECT value FROM metadata WHERE key = 'initialized'"
    ).fetchone()
    return row is not None and row[0] == "1"


def initialize(connection, roots, force=False):
    """Baseline existing logs so installation never replays old failures."""
    if initialized(connection) and not force:
        return False
    count = 0
    with connection:
        for path, account in rollout_files(roots):
            count += bool(baseline_file(connection, path.resolve(strict=False), account))
        connection.execute(
            "INSERT OR REPLACE INTO metadata (key, value) VALUES ('initialized', '1')"
        )
    log(event="failure-watch-initialized", files=count)
    return True


def reconcile(connection, roots, dispatch=dispatch_failure):
    active = set()
    for path, account in rollout_files(roots):
        resolved = path.resolve(strict=False)
        active.add(str(resolved))
        process_file(connection, resolved, account, dispatch)
    # Rollout files are append-only. Removing rows for deleted files keeps the
    # durable index bounded without affecting live sessions.
    stored = {
        row[0] for row in connection.execute("SELECT path FROM rollout_files")
    }
    missing = stored - active
    if missing:
        with connection:
            connection.executemany(
                "DELETE FROM rollout_files WHERE path = ?",
                ((path,) for path in missing),
            )


def t3_event_alert(connection, thread_id, occurred_at, event_type, event):
    if event_type == "run.updated":
        if event.get("delegatedTaskId") or not live_timestamp(event.get("completedAt") or occurred_at):
            return None
        failure = connection.execute(
            """
            SELECT provider_turn_id, json_extract(payload_json, '$.failure.message')
            FROM orchestration_v2_projection_turn_items
            WHERE thread_id = ? AND run_id = ? AND node_id = ?
              AND type = 'error' AND status = 'failed'
            ORDER BY updated_at DESC, ordinal DESC, turn_item_id DESC LIMIT 1
            """,
            (thread_id, event["id"], event.get("rootNodeId")),
        ).fetchone()
        turn_id, message = failure or (None, None)
        alert = {"error": compact(message) or "The T3 Code run failed."}
        fallback_turn_id = event["id"]
    else:
        if not live_timestamp(event.get("startedAt") or occurred_at):
            return None
        pending = connection.execute(
            """
            SELECT 1 FROM orchestration_v2_projection_turn_items
            WHERE turn_item_id = ? AND status IN ('pending', 'waiting')
            """,
            (event["id"],),
        ).fetchone()
        if not pending:
            return None
        is_approval = event["type"] == "approval_request"
        native_item = event.get("nativeItemRef") or {}
        native_request_id = None if is_approval else native_item.get("nativeId")
        request_id = native_request_id or event.get("requestId") or event["id"]
        message = question_message(event.get("questions")) or compact(event.get("prompt"))
        fallback_message = (
            "T3 Code needs your approval." if is_approval else "T3 Code needs your input."
        )
        alert = {"request_id": request_id, "input_message": message or fallback_message}
        turn_id = event.get("providerTurnId")
        fallback_turn_id = turn_id or ""

    context = connection.execute(
        """
        SELECT json_extract(provider_thread.payload_json, '$.nativeThreadRef.nativeId'),
               json_extract(turn.payload_json, '$.nativeTurnRef.nativeId'),
               COALESCE(json_extract(thread.payload_json, '$.worktreePath'), project.workspace_root),
               COALESCE(json_extract(turn.payload_json, '$.model'),
                        json_extract(run.payload_json, '$.modelSelection.model')),
               COALESCE(run.provider_instance_id, provider_thread.provider_instance_id,
                        thread.provider_instance_id),
               COALESCE(provider_thread.driver, thread.default_provider)
        FROM orchestration_v2_projection_threads AS thread
        LEFT JOIN projection_projects AS project ON project.project_id = thread.project_id
        LEFT JOIN orchestration_v2_projection_runs AS run ON run.run_id = ?
        LEFT JOIN orchestration_v2_projection_provider_turns AS turn ON turn.provider_turn_id = ?
        LEFT JOIN orchestration_v2_projection_provider_threads AS provider_thread
          ON provider_thread.provider_thread_id = COALESCE(
              turn.provider_thread_id, ?, thread.active_provider_thread_id
          )
        WHERE thread.thread_id = ? AND thread.deleted_at IS NULL
          AND json_extract(thread.payload_json, '$.lineage.relationshipToParent') IS NOT 'subagent'
        """,
        (
            event["id"] if event_type == "run.updated" else event.get("runId"),
            turn_id, event.get("providerThreadId"), thread_id,
        ),
    ).fetchone()
    if not context:
        return None

    session_id, native_turn_id, cwd, model, instance_id, driver = context
    alert.update(
        session_id=session_id or thread_id,
        turn_id=native_turn_id or fallback_turn_id,
        t3_thread_id=thread_id,
        cwd=cwd or "",
        model=model or "",
    )
    account = t3_account(instance_id, driver or "codex", T3_SETTINGS_FILE)
    return alert, account


class T3Events:
    """Read new T3 events in sequence without writing to its database."""

    def __init__(self):
        self.identity = None
        self.sequence = 0

    def poll(self, path, dispatch=dispatch_failure):
        try:
            status = path.stat()
            identity = (status.st_dev, status.st_ino)
            with closing(open_t3_db(path)) as connection:
                if self.identity != identity:
                    self.sequence = connection.execute(
                        "SELECT COALESCE(MAX(sequence), 0) FROM orchestration_events"
                    ).fetchone()[0]
                    self.identity = identity
                    return
                boundary = connection.execute(
                    """
                    SELECT COALESCE(
                        (SELECT sequence FROM orchestration_events WHERE sequence > ?
                         ORDER BY sequence LIMIT 1 OFFSET ?),
                        (SELECT MAX(sequence) FROM orchestration_events)
                    )
                    """,
                    (self.sequence, T3_BATCH_SIZE - 1),
                ).fetchone()[0]
                if boundary is None or boundary <= self.sequence:
                    return
                alerts = []
                for sequence, thread_id, stamp, kind, payload in connection.execute(
                    """
                    SELECT sequence, stream_id, occurred_at, event_type, payload_json
                    FROM orchestration_events
                    WHERE sequence > ? AND sequence <= ? AND aggregate_kind = 'thread'
                      AND CASE event_type
                          WHEN 'run.updated' THEN json_extract(payload_json, '$.status') = 'failed'
                          WHEN 'turn-item.updated' THEN
                            json_extract(payload_json, '$.type') IN ('user_input_request', 'approval_request')
                            AND json_extract(payload_json, '$.status') IN ('pending', 'waiting')
                          ELSE 0
                      END
                    ORDER BY sequence
                    """,
                    (self.sequence, boundary),
                ):
                    if live_timestamp(stamp):
                        alert = t3_event_alert(connection, thread_id, stamp, kind, json.loads(payload))
                        if alert:
                            alerts.append((sequence, alert))
        except (OSError, sqlite3.Error):
            return

        for sequence, alert in alerts:
            if not dispatch(*alert):
                self.sequence = sequence - 1
                return
        self.sequence = boundary


class Inotify:
    def __init__(self):
        libc = ctypes.CDLL(None, use_errno=True)
        self._add_watch = libc.inotify_add_watch
        self._add_watch.argtypes = (ctypes.c_int, ctypes.c_char_p, ctypes.c_uint32)
        self._add_watch.restype = ctypes.c_int
        init = libc.inotify_init1
        init.argtypes = (ctypes.c_int,)
        init.restype = ctypes.c_int
        self.fd = init(os.O_NONBLOCK | os.O_CLOEXEC)
        if self.fd < 0:
            error = ctypes.get_errno()
            raise OSError(error, os.strerror(error))
        self.paths = {}

    def close(self):
        if self.fd >= 0:
            os.close(self.fd)
            self.fd = -1

    def add_directory(self, path):
        encoded = os.fsencode(path)
        descriptor = self._add_watch(self.fd, encoded, WATCH_MASK)
        if descriptor < 0:
            error = ctypes.get_errno()
            if error not in (errno.ENOENT, errno.ENOTDIR):
                raise OSError(error, os.strerror(error), str(path))
            return
        self.paths[descriptor] = Path(path)

    def add_tree(self, root):
        for directory, _, _ in os.walk(root):
            self.add_directory(Path(directory))

    def read_events(self):
        events = []
        while True:
            try:
                data = os.read(self.fd, 256 * 1024)
            except BlockingIOError:
                break
            if not data:
                break
            position = 0
            while position + EVENT_HEADER.size <= len(data):
                descriptor, mask, cookie, length = EVENT_HEADER.unpack_from(data, position)
                position += EVENT_HEADER.size
                name_bytes = data[position:position + length].split(b"\0", 1)[0]
                position += length
                events.append((descriptor, mask, cookie, os.fsdecode(name_bytes)))
        return events


def watch(connection, roots):
    monitor = Inotify()
    poller = select.poll()
    poller.register(monitor.fd, select.POLLIN)
    stopping = False

    def stop(_signum, _frame):
        nonlocal stopping
        stopping = True
        raise SystemExit(0)

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    try:
        t3_events = T3Events()
        if t3_enabled():
            t3_events.poll(T3_CURRENT_DB)
        for root, _account in roots:
            monitor.add_tree(root)
        initialize(connection, roots, force=True)
        if initialized(connection):
            reconcile(connection, roots)

        next_reconcile = time.monotonic() + RECONCILE_SECONDS
        next_account_scan = time.monotonic() + ACCOUNT_RESCAN_SECONDS
        next_t3_poll = time.monotonic()
        save_status(
            running=True,
            pid=os.getpid(),
            roots=[str(root) for root, _account in roots],
            watched_directories=len(monitor.paths),
            last_error="",
        )
        while not stopping:
            timeout = max(0, min(next_reconcile, next_account_scan, next_t3_poll) - time.monotonic())
            poller.poll(min(1000, round(timeout * 1000)))
            changed = False
            overflow = False
            accounts = {str(root): account for root, account in roots}
            for descriptor, mask, _cookie, name in monitor.read_events():
                if mask & IN_Q_OVERFLOW:
                    overflow = True
                    continue
                directory = monitor.paths.get(descriptor)
                if directory is None:
                    continue
                if mask & IN_IGNORED:
                    monitor.paths.pop(descriptor, None)
                    continue
                candidate = directory / name if name else directory
                if mask & IN_ISDIR:
                    if mask & (IN_CREATE | IN_MOVED_TO):
                        monitor.add_tree(candidate)
                        overflow = True
                    continue
                if candidate.name.endswith(".jsonl") and mask & (
                    IN_MODIFY | IN_CLOSE_WRITE | IN_CREATE | IN_MOVED_TO
                ):
                    account = next(
                        (
                            value for root, value in accounts.items()
                            if candidate == Path(root) or Path(root) in candidate.parents
                        ),
                        "codex",
                    )
                    changed |= process_file(connection, candidate, account)

            now = time.monotonic()
            if now >= next_t3_poll:
                if t3_enabled():
                    t3_events.poll(T3_CURRENT_DB)
                else:
                    t3_events.identity = None
                next_t3_poll = now + T3_POLL_SECONDS
            if now >= next_account_scan:
                updated_roots = session_roots()
                known = {str(root) for root, _account in roots}
                for root, _account in updated_roots:
                    if str(root) not in known:
                        monitor.add_tree(root)
                roots = updated_roots
                next_account_scan = now + ACCOUNT_RESCAN_SECONDS
                overflow = True
            if overflow or now >= next_reconcile:
                reconcile(connection, roots)
                next_reconcile = now + RECONCILE_SECONDS
                changed = True
            if changed:
                save_status(
                    running=True,
                    pid=os.getpid(),
                    roots=[str(root) for root, _account in roots],
                    watched_directories=len(monitor.paths),
                    last_scan_at=time.time(),
                )
    finally:
        monitor.close()
        save_status(running=False, pid=None)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--once", action="store_true",
        help="process appended rollout records once, without waiting for changes",
    )
    args = parser.parse_args()

    STATE_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
    with LOCK_FILE.open("a+", encoding="utf-8") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return 0
        roots = session_roots()
        with connect_db() as connection:
            if args.once:
                initialize(connection, roots, force=True)
                reconcile(connection, roots)
                return 0
            watch(connection, roots)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
