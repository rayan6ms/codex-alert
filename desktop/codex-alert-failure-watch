#!/usr/bin/python3

"""Watch Codex rollout logs for terminal turn failures.

Codex currently invokes Stop hooks only for successful turns. Its rollout log,
however, records every terminal turn as ``task_complete`` and includes an
``error`` object when the turn failed. This watcher follows only newly appended
records and forwards those terminal failures through the same notification
wrapper used by the Stop hook.
"""

import argparse
import ctypes
import errno
import fcntl
import json
import os
import select
import signal
import sqlite3
import struct
import subprocess
import sys
import time
from contextlib import closing
from datetime import datetime
from pathlib import Path

from codex_alert_common import STATE_DIR, atomic_json, codex_homes


NOTIFIER = Path.home() / ".local/bin/codex-notify-stop"
DB_FILE = STATE_DIR / "failure-watch.sqlite3"
LOCK_FILE = STATE_DIR / "failure-watch.lock"
STATUS_FILE = STATE_DIR / "failure-watch-status.json"
LOG_FILE = STATE_DIR / "failure-watch.log"
T3_STATE_DB = Path.home() / ".t3/userdata/state.sqlite"
T3_SETTINGS_FILE = Path.home() / ".t3/userdata/settings.json"
MAX_LOG_BYTES = 1024 * 1024
MAX_RELEVANT_RECORD_BYTES = 8 * 1024 * 1024
RECONCILE_SECONDS = 60
ACCOUNT_RESCAN_SECONDS = 5 * 60

IN_MODIFY = 0x00000002
IN_CLOSE_WRITE = 0x00000008
IN_MOVED_TO = 0x00000080
IN_CREATE = 0x00000100
IN_DELETE_SELF = 0x00000400
IN_MOVE_SELF = 0x00000800
IN_Q_OVERFLOW = 0x00004000
IN_IGNORED = 0x00008000
IN_ISDIR = 0x40000000
WATCH_MASK = (
    IN_MODIFY
    | IN_CLOSE_WRITE
    | IN_MOVED_TO
    | IN_CREATE
    | IN_DELETE_SELF
    | IN_MOVE_SELF
)
EVENT_HEADER = struct.Struct("iIII")


def clean_environment():
    environment = os.environ.copy()
    for key in ("LD_LIBRARY_PATH", "LD_PRELOAD", "LD_AUDIT", "LD_DEBUG"):
        environment.pop(key, None)
    return environment


def compact(value, limit=1200):
    text = str(value or "").strip()
    return text if len(text) <= limit else text[: limit - 1] + "…"


def log(**record):
    try:
        STATE_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
        if LOG_FILE.exists() and LOG_FILE.stat().st_size >= MAX_LOG_BYTES:
            previous = LOG_FILE.with_suffix(LOG_FILE.suffix + ".1")
            previous.unlink(missing_ok=True)
            LOG_FILE.replace(previous)
        record["time"] = datetime.now().astimezone().isoformat(timespec="seconds")
        with LOG_FILE.open("a", encoding="utf-8") as stream:
            stream.write(json.dumps(record, ensure_ascii=False) + "\n")
    except OSError:
        pass


def save_status(**changes):
    try:
        current = {}
        try:
            value = json.loads(STATUS_FILE.read_text(encoding="utf-8"))
            current = value if isinstance(value, dict) else {}
        except (OSError, ValueError):
            pass
        current.update(changes)
        current["updated_at"] = time.time()
        atomic_json(STATUS_FILE, current)
    except OSError:
        pass


def connect_db(path=DB_FILE):
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    connection = sqlite3.connect(path, timeout=5)
    connection.row_factory = sqlite3.Row
    connection.execute("PRAGMA busy_timeout=5000")
    connection.execute("PRAGMA journal_mode=WAL")
    connection.execute("PRAGMA synchronous=NORMAL")
    connection.execute(
        """
        CREATE TABLE IF NOT EXISTS metadata (
            key TEXT PRIMARY KEY,
            value TEXT NOT NULL
        )
        """
    )
    connection.execute(
        """
        CREATE TABLE IF NOT EXISTS rollout_files (
            path TEXT PRIMARY KEY,
            device INTEGER NOT NULL,
            inode INTEGER NOT NULL,
            offset INTEGER NOT NULL,
            account TEXT NOT NULL,
            session_id TEXT NOT NULL DEFAULT '',
            cwd TEXT NOT NULL DEFAULT '',
            originator TEXT NOT NULL DEFAULT '',
            source_json TEXT NOT NULL DEFAULT 'null',
            thread_source TEXT NOT NULL DEFAULT '',
            history_mode TEXT NOT NULL DEFAULT '',
            model TEXT NOT NULL DEFAULT '',
            model_turn_id TEXT NOT NULL DEFAULT '',
            updated_at REAL NOT NULL
        )
        """
    )
    connection.commit()
    try:
        path.chmod(0o600)
    except OSError:
        pass
    return connection


def account_name(home):
    return home.name.lstrip(".") or "codex"


def session_roots(homes=None):
    """Return each physical sessions tree once, even for shadow homes."""
    roots = {}
    for home in codex_homes() if homes is None else homes:
        sessions = home / "sessions"
        try:
            resolved = sessions.resolve(strict=True)
            status = resolved.stat()
        except OSError:
            continue
        identity = (status.st_dev, status.st_ino)
        roots.setdefault(identity, (resolved, account_name(home)))
    return sorted(roots.values(), key=lambda item: str(item[0]))


def rollout_files(roots):
    for root, account in roots:
        try:
            for directory, _, filenames in os.walk(root):
                base = Path(directory)
                for filename in filenames:
                    if filename.endswith(".jsonl"):
                        yield base / filename, account
        except OSError:
            continue


def fresh_context(path, account, status, offset=0):
    return {
        "path": str(path),
        "device": status.st_dev,
        "inode": status.st_ino,
        "offset": offset,
        "account": account,
        "session_id": "",
        "cwd": "",
        "originator": "",
        "source_json": "null",
        "thread_source": "",
        "history_mode": "",
        "model": "",
        "model_turn_id": "",
        "updated_at": time.time(),
    }


def context_from_row(row):
    return dict(row)


def save_context(connection, context):
    context["updated_at"] = time.time()
    connection.execute(
        """
        INSERT INTO rollout_files (
            path, device, inode, offset, account, session_id, cwd,
            originator, source_json, thread_source, history_mode, model,
            model_turn_id, updated_at
        ) VALUES (
            :path, :device, :inode, :offset, :account, :session_id, :cwd,
            :originator, :source_json, :thread_source, :history_mode, :model,
            :model_turn_id, :updated_at
        )
        ON CONFLICT(path) DO UPDATE SET
            device=excluded.device,
            inode=excluded.inode,
            offset=excluded.offset,
            account=excluded.account,
            session_id=excluded.session_id,
            cwd=excluded.cwd,
            originator=excluded.originator,
            source_json=excluded.source_json,
            thread_source=excluded.thread_source,
            history_mode=excluded.history_mode,
            model=excluded.model,
            model_turn_id=excluded.model_turn_id,
            updated_at=excluded.updated_at
        """,
        context,
    )


def source_value(context):
    try:
        return json.loads(context.get("source_json") or "null")
    except ValueError:
        return None


def ignored_session(context):
    source = source_value(context)
    if context.get("thread_source") == "subagent":
        return True
    if isinstance(source, dict) and "subagent" in source:
        return True
    # Ephemeral execs do not normally create rollout files. Keep these guards
    # for forward compatibility if Codex starts persisting explicit metadata.
    if context.get("history_mode") in ("ephemeral", "transient", "disabled"):
        return True
    if source == "ephemeral":
        return True
    return False


def account_for_session(session_id, fallback, state_db=None, settings_file=None):
    """Resolve T3's provider instance when shadow homes share one log tree."""
    database = T3_STATE_DB if state_db is None else Path(state_db)
    settings_path = T3_SETTINGS_FILE if settings_file is None else Path(settings_file)
    if not database.is_file() or not settings_path.is_file():
        return fallback
    try:
        uri = database.resolve().as_uri() + "?mode=ro"
        instance_id = None
        with closing(sqlite3.connect(uri, uri=True, timeout=0.25)) as connection:
            rows = connection.execute(
                """
                SELECT provider_instance_id, resume_cursor_json
                FROM provider_session_runtime
                WHERE lower(provider_name) = 'codex'
                """
            )
            for candidate, cursor_json in rows:
                try:
                    cursor = json.loads(cursor_json or "{}")
                except (TypeError, ValueError):
                    continue
                if cursor.get("threadId") == session_id:
                    instance_id = str(candidate or "codex")
                    break
        if not instance_id:
            return fallback
        settings_value = json.loads(settings_path.read_text(encoding="utf-8"))
        instance = settings_value.get("providerInstances", {}).get(instance_id, {})
        config = instance.get("config", {}) if isinstance(instance, dict) else {}
        configured_home = config.get("shadowHomePath") or config.get("homePath")
        if configured_home:
            name = Path(str(configured_home)).name.lstrip(".")
            if name:
                return name
        if instance_id == "codex":
            return "codex"
        prefix = "codex_account"
        if instance_id.startswith(prefix) and instance_id[len(prefix):].isdigit():
            return "codex" + instance_id[len(prefix):]
    except (AttributeError, OSError, sqlite3.Error, TypeError, ValueError):
        pass
    return fallback


def error_message(error):
    if isinstance(error, dict):
        message = error.get("message") or error.get("additional_details")
        if message:
            return compact(message)
        return compact(json.dumps(error, ensure_ascii=False, separators=(",", ":")))
    return compact(error)


def handle_record(context, row, dispatch):
    """Update file context and dispatch one true terminal failure if present."""
    if not isinstance(row, dict):
        return True
    payload = row.get("payload")
    if not isinstance(payload, dict):
        return True

    row_type = row.get("type")
    if row_type == "session_meta":
        context["session_id"] = str(
            payload.get("session_id") or payload.get("id") or context["session_id"]
        )
        context["cwd"] = str(payload.get("cwd") or context["cwd"])
        context["originator"] = str(payload.get("originator") or "")
        context["source_json"] = json.dumps(
            payload.get("source"), ensure_ascii=False, separators=(",", ":")
        )
        context["thread_source"] = str(payload.get("thread_source") or "")
        context["history_mode"] = str(payload.get("history_mode") or "")
        return True

    if row_type == "turn_context":
        context["cwd"] = str(payload.get("cwd") or context["cwd"])
        context["model"] = str(payload.get("model") or context["model"])
        context["model_turn_id"] = str(payload.get("turn_id") or "")
        return True

    if row_type != "event_msg" or payload.get("type") != "task_complete":
        return True
    error = payload.get("error")
    if not error or ignored_session(context):
        return True

    session_id = str(context.get("session_id") or "").strip()
    turn_id = str(payload.get("turn_id") or "").strip()
    if not session_id or not turn_id:
        log(
            event="failure-missing-identity",
            path=context.get("path"),
            session_id=session_id,
            turn_id=turn_id,
        )
        return True

    model = context.get("model") if context.get("model_turn_id") == turn_id else ""
    failure = {
        "session_id": session_id,
        "turn_id": turn_id,
        "cwd": context.get("cwd") or "",
        "model": model,
        "error": error_message(error) or "The Codex task failed.",
    }
    account = context.get("account") or "codex"
    if context.get("originator") == "t3code_desktop":
        account = account_for_session(session_id, account)
    return bool(dispatch(failure, account))


def dispatch_failure(payload, account):
    try:
        result = subprocess.run(
            [str(NOTIFIER), "--failure", "--account", account],
            input=json.dumps(payload, ensure_ascii=False),
            text=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            env=clean_environment(),
            check=False,
            timeout=8,
        )
        if result.returncode == 0:
            log(
                event="failure-forwarded",
                account=account,
                session_id=payload.get("session_id"),
                turn_id=payload.get("turn_id"),
            )
            save_status(
                last_failure_at=time.time(),
                last_session_id=payload.get("session_id"),
                last_turn_id=payload.get("turn_id"),
                last_error="",
            )
            return True
        log(event="failure-forward-failed", returncode=result.returncode,
            error=compact(result.stderr, 500))
    except Exception as exc:
        log(event="failure-forward-failed", error=repr(exc))
    save_status(last_error="Could not forward a Codex failure notification")
    return False


def load_context(connection, path):
    row = connection.execute(
        "SELECT * FROM rollout_files WHERE path = ?", (str(path),)
    ).fetchone()
    return context_from_row(row) if row is not None else None


def read_first_record(path):
    try:
        with path.open("rb") as stream:
            raw = stream.readline()
        return json.loads(raw) if raw.endswith(b"\n") else None
    except (OSError, ValueError):
        return None


def baseline_file(connection, path, account):
    try:
        status = path.stat()
    except OSError:
        return False
    context = fresh_context(path, account, status, status.st_size)
    first = read_first_record(path)
    if first is not None:
        handle_record(context, first, lambda _payload, _account: True)
    save_context(connection, context)
    return True


def process_file(connection, path, account, dispatch=dispatch_failure):
    """Consume complete records appended after the durable file offset."""
    path = Path(path).resolve(strict=False)
    try:
        status = path.stat()
        if not path.is_file():
            return False
    except OSError:
        return False

    context = load_context(connection, path)
    if (
        context is None
        or context["device"] != status.st_dev
        or context["inode"] != status.st_ino
        or status.st_size < context["offset"]
    ):
        context = fresh_context(path, account, status)
    else:
        context["account"] = account

    committed = int(context["offset"])
    changed = False
    try:
        with path.open("rb") as stream:
            opened = os.fstat(stream.fileno())
            if (opened.st_dev, opened.st_ino) != (status.st_dev, status.st_ino):
                return False
            stream.seek(committed)
            while True:
                start = stream.tell()
                raw = stream.readline()
                if not raw:
                    break
                if not raw.endswith(b"\n"):
                    break
                # Most rollout records are model content or tool traffic and
                # can be very large. Avoid decoding them altogether; only the
                # three small record families below affect terminal alerts.
                if not any(
                    marker in raw
                    for marker in (b"session_meta", b"turn_context", b"task_complete")
                ):
                    committed = stream.tell()
                    changed = True
                    continue
                if len(raw) > MAX_RELEVANT_RECORD_BYTES:
                    log(event="oversized-rollout-record-ignored", path=str(path),
                        offset=start, bytes=len(raw))
                    committed = stream.tell()
                    changed = True
                    continue
                try:
                    row = json.loads(raw)
                except (UnicodeDecodeError, ValueError):
                    log(event="invalid-rollout-record", path=str(path), offset=start)
                    committed = stream.tell()
                    changed = True
                    continue
                if not handle_record(context, row, dispatch):
                    break
                committed = stream.tell()
                changed = True
    except OSError as exc:
        log(event="rollout-read-failed", path=str(path), error=repr(exc))
        return False

    context["offset"] = committed
    if changed or load_context(connection, path) is None:
        save_context(connection, context)
        connection.commit()
    return changed


def initialized(connection):
    row = connection.execute(
        "SELECT value FROM metadata WHERE key = 'initialized'"
    ).fetchone()
    return row is not None and row[0] == "1"


def initialize(connection, roots):
    """Baseline existing logs so installation never replays old failures."""
    if initialized(connection):
        return False
    count = 0
    with connection:
        for path, account in rollout_files(roots):
            count += bool(baseline_file(connection, path.resolve(strict=False), account))
        connection.execute(
            "INSERT OR REPLACE INTO metadata (key, value) VALUES ('initialized', '1')"
        )
    log(event="failure-watch-initialized", files=count)
    return True


def reconcile(connection, roots, dispatch=dispatch_failure):
    active = set()
    for path, account in rollout_files(roots):
        resolved = path.resolve(strict=False)
        active.add(str(resolved))
        process_file(connection, resolved, account, dispatch)
    # Rollout files are append-only. Removing rows for deleted files keeps the
    # durable index bounded without affecting live sessions.
    stored = {
        row[0] for row in connection.execute("SELECT path FROM rollout_files")
    }
    missing = stored - active
    if missing:
        with connection:
            connection.executemany(
                "DELETE FROM rollout_files WHERE path = ?",
                ((path,) for path in missing),
            )


class Inotify:
    def __init__(self):
        libc = ctypes.CDLL(None, use_errno=True)
        self._add_watch = libc.inotify_add_watch
        self._add_watch.argtypes = (ctypes.c_int, ctypes.c_char_p, ctypes.c_uint32)
        self._add_watch.restype = ctypes.c_int
        init = libc.inotify_init1
        init.argtypes = (ctypes.c_int,)
        init.restype = ctypes.c_int
        self.fd = init(os.O_NONBLOCK | os.O_CLOEXEC)
        if self.fd < 0:
            error = ctypes.get_errno()
            raise OSError(error, os.strerror(error))
        self.paths = {}

    def close(self):
        if self.fd >= 0:
            os.close(self.fd)
            self.fd = -1

    def add_directory(self, path):
        encoded = os.fsencode(path)
        descriptor = self._add_watch(self.fd, encoded, WATCH_MASK)
        if descriptor < 0:
            error = ctypes.get_errno()
            if error not in (errno.ENOENT, errno.ENOTDIR):
                raise OSError(error, os.strerror(error), str(path))
            return
        self.paths[descriptor] = Path(path)

    def add_tree(self, root):
        for directory, _, _ in os.walk(root):
            self.add_directory(Path(directory))

    def read_events(self):
        events = []
        while True:
            try:
                data = os.read(self.fd, 256 * 1024)
            except BlockingIOError:
                break
            if not data:
                break
            position = 0
            while position + EVENT_HEADER.size <= len(data):
                descriptor, mask, cookie, length = EVENT_HEADER.unpack_from(data, position)
                position += EVENT_HEADER.size
                name_bytes = data[position:position + length].split(b"\0", 1)[0]
                position += length
                events.append((descriptor, mask, cookie, os.fsdecode(name_bytes)))
        return events


def watch(connection, roots):
    monitor = Inotify()
    poller = select.poll()
    poller.register(monitor.fd, select.POLLIN)
    stopping = False

    def stop(_signum, _frame):
        nonlocal stopping
        stopping = True

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    try:
        for root, _account in roots:
            monitor.add_tree(root)
        initialize(connection, roots)
        if initialized(connection):
            reconcile(connection, roots)

        next_reconcile = time.monotonic() + RECONCILE_SECONDS
        next_account_scan = time.monotonic() + ACCOUNT_RESCAN_SECONDS
        save_status(
            running=True,
            pid=os.getpid(),
            roots=[str(root) for root, _account in roots],
            watched_directories=len(monitor.paths),
            last_error="",
        )
        while not stopping:
            timeout = max(0, min(next_reconcile, next_account_scan) - time.monotonic())
            poller.poll(round(timeout * 1000))
            changed = False
            overflow = False
            accounts = {str(root): account for root, account in roots}
            for descriptor, mask, _cookie, name in monitor.read_events():
                if mask & IN_Q_OVERFLOW:
                    overflow = True
                    continue
                directory = monitor.paths.get(descriptor)
                if directory is None:
                    continue
                if mask & IN_IGNORED:
                    monitor.paths.pop(descriptor, None)
                    continue
                candidate = directory / name if name else directory
                if mask & IN_ISDIR:
                    if mask & (IN_CREATE | IN_MOVED_TO):
                        monitor.add_tree(candidate)
                        overflow = True
                    continue
                if candidate.name.endswith(".jsonl") and mask & (
                    IN_MODIFY | IN_CLOSE_WRITE | IN_CREATE | IN_MOVED_TO
                ):
                    account = next(
                        (
                            value for root, value in accounts.items()
                            if candidate == Path(root) or Path(root) in candidate.parents
                        ),
                        "codex",
                    )
                    changed |= process_file(connection, candidate, account)

            now = time.monotonic()
            if now >= next_account_scan:
                updated_roots = session_roots()
                known = {str(root) for root, _account in roots}
                for root, _account in updated_roots:
                    if str(root) not in known:
                        monitor.add_tree(root)
                roots = updated_roots
                next_account_scan = now + ACCOUNT_RESCAN_SECONDS
                overflow = True
            if overflow or now >= next_reconcile:
                reconcile(connection, roots)
                next_reconcile = now + RECONCILE_SECONDS
                changed = True
            if changed:
                save_status(
                    running=True,
                    pid=os.getpid(),
                    roots=[str(root) for root, _account in roots],
                    watched_directories=len(monitor.paths),
                    last_scan_at=time.time(),
                )
    finally:
        monitor.close()
        save_status(running=False, pid=None)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--once", action="store_true",
        help="process appended rollout records once, without waiting for changes",
    )
    args = parser.parse_args()

    STATE_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
    with LOCK_FILE.open("a+", encoding="utf-8") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return 0
        roots = session_roots()
        with connect_db() as connection:
            if args.once:
                initialize(connection, roots)
                reconcile(connection, roots)
                return 0
            watch(connection, roots)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
