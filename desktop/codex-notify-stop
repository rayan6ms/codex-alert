import hashlib
import html
import json
import os
import re
import subprocess
import sys
from pathlib import Path

from agents_alert_providers import (
    ANTIGRAVITY,
    CLAUDE,
    PROVIDER_NAMES,
    T3_PROVIDERS,
    antigravity_event,
    claude_event,
    t3_handles_session,
)
from codex_alert_common import (
    APP_NAME,
    T3_CURRENT_DB,
    T3_LEGACY_DB,
    T3_STATE_DIR,
    clean_title,
    codex_session_title,
    is_t3_scratch_path,
