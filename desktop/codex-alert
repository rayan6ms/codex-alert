#!/usr/bin/python3

"""Set up, pair, test, and inspect Codex Alert."""

import argparse
import hashlib
import http.client
import ipaddress
import json
import os
import re
import socket
import ssl
import subprocess
import sys
import time
import uuid
from pathlib import Path

from codex_alert_common import (
    CERTIFICATE_FILE,
    CONFIG_DIR,
    PHONE_FILE,
    TOKEN_FILE,
    atomic_json,
    codex_homes,
    phone,
    phone_configured,
    set_t3_enabled,
    settings,
)


PORT = 24601
HOOK_COMMAND = str(Path.home() / ".local/bin/codex-notify-stop")
PHONE_DELIVER = Path.home() / ".local/bin/codex-phone-deliver"
DESKTOP_NOTIFY = Path.home() / ".local/bin/codex-notify-stop-desktop"
PAIR_CODE = re.compile(r"[0-9]{8}")


def run(command, timeout=10):
    return subprocess.run(
        command,
        check=False,
        timeout=timeout,
        capture_output=True,
        text=True,
    )


def hook_definition():
    return {
        "hooks": [
            {
                "type": "command",
                "command": HOOK_COMMAND,
                "timeout": 5,
            }
        ]
    }


def is_codex_alert_hook(value):
    if not isinstance(value, dict):
        return False
    command = str(value.get("command") or "")
    return "codex-notify-stop" in command or "codex-alert hook" in command


def sync_hook_file(path):
    try:
        value = json.loads(path.read_text(encoding="utf-8")) if path.exists() else {}
    except (OSError, ValueError) as exc:
        raise RuntimeError(f"cannot safely update invalid JSON in {path}: {exc}") from exc
    if not isinstance(value, dict):
        raise RuntimeError(f"cannot safely update non-object JSON in {path}")

    hooks = value.setdefault("hooks", {})
    if not isinstance(hooks, dict):
        raise RuntimeError(f"cannot safely update invalid hooks in {path}")
    stop = hooks.setdefault("Stop", [])
    if not isinstance(stop, list):
        raise RuntimeError(f"cannot safely update invalid Stop hooks in {path}")

    found = False
    for group in stop:
        if not isinstance(group, dict) or not isinstance(group.get("hooks"), list):
            continue
        for index, entry in enumerate(group["hooks"]):
            if is_codex_alert_hook(entry):
                if not found:
                    group["hooks"][index] = hook_definition()["hooks"][0]
                    found = True
                else:
                    group["hooks"][index] = None
        group["hooks"] = [entry for entry in group["hooks"] if entry is not None]
    if not found:
        stop.append(hook_definition())

    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f"{path.name}.{os.getpid()}.tmp")
    temporary.write_text(json.dumps(value, indent=2) + "\n", encoding="utf-8")
    temporary.chmod(0o600)
    temporary.replace(path)


def sync_hooks(quiet=False):
    homes = codex_homes()
    failures = []
    for home in homes:
        try:
            sync_hook_file(home / "hooks.json")
        except RuntimeError as exc:
            failures.append(str(exc))
    if not quiet:
        print(f"Configured {len(homes) - len(failures)} Codex profile(s).")
    for failure in failures:
        print(f"Warning: {failure}", file=sys.stderr)
    return 1 if failures else 0


def discover_phones():
    binary = Path("/usr/bin/avahi-browse")
    if not binary.exists():
        return []
    result = run([str(binary), "--resolve", "--terminate", "--parsable", "_codexalert._tcp"], 5)
    if result.returncode != 0:
        return []
    found = []
    seen = set()
    for line in result.stdout.splitlines():
        fields = line.split(";")
        if len(fields) < 9 or fields[0] != "=" or fields[2] != "IPv4":
            continue
        name, host, port = fields[3].strip(), fields[7].strip(), fields[8].strip()
        if host and port == str(PORT) and host not in seen:
            seen.add(host)
            found.append((name or "Android phone", host))
    return found


def choose_phone(explicit_host=None):
    if explicit_host:
        return explicit_host
    phones = discover_phones()
    if len(phones) == 1:
        print(f"Found {phones[0][0]} at {phones[0][1]}.")
        return phones[0][1]
    if len(phones) > 1:
        print("Found multiple phones:")
        for index, (name, host) in enumerate(phones, 1):
            print(f"  {index}. {name} · {host}")
        while True:
            choice = input("Choose a phone: ").strip()
            if choice.isdigit() and 1 <= int(choice) <= len(phones):
                return phones[int(choice) - 1][1]
    return input("Phone address shown in Codex Alert: ").strip()


def pair_request(host, code, confirm_certificate):
    context = ssl._create_unverified_context()
    context.minimum_version = ssl.TLSVersion.TLSv1_2
    connection = http.client.HTTPSConnection(host, PORT, timeout=8, context=context)
    payload = json.dumps({"code": code}, separators=(",", ":")).encode("utf-8")
    try:
        connection.connect()
        certificate = connection.sock.getpeercert(binary_form=True)
        if not confirm_certificate(certificate):
            raise RuntimeError("pairing cancelled; security codes did not match")
        connection.request(
            "POST",
            "/v1/pair",
            body=payload,
            headers={
                "Content-Type": "application/json",
                "Content-Length": str(len(payload)),
                "Connection": "close",
            },
        )
        response = connection.getresponse()
        body = response.read(8192).decode("utf-8", errors="replace")
        try:
            result = json.loads(body)
        except ValueError as exc:
            raise RuntimeError(f"phone returned an invalid response (HTTP {response.status})") from exc
        if response.status != 200 or result.get("status") != "paired":
            raise RuntimeError(str(result.get("message") or result.get("status") or response.status))
        return result, certificate
    finally:
        connection.close()


def private_target(value):
    try:
        address = ipaddress.ip_address(value)
        private_networks = (
            ipaddress.ip_network("10.0.0.0/8"),
            ipaddress.ip_network("172.16.0.0/12"),
            ipaddress.ip_network("192.168.0.0/16"),
            ipaddress.ip_network("100.64.0.0/10"),
            ipaddress.ip_network("fd7a:115c:a1e0::/48"),
        )
        return any(address in network for network in private_networks)
    except ValueError:
        return value.endswith(".local")


def save_pairing(host, result, certificate):
    token = str(result.get("token") or "")
    if not re.fullmatch(r"[0-9a-f]{64}", token):
        raise RuntimeError("phone returned an invalid delivery token")
    targets = []
    for candidate in [host, *(result.get("addresses") or [])]:
        candidate = str(candidate).strip().split("%", 1)[0]
        if candidate and private_target(candidate) and candidate not in targets:
            targets.append(candidate)
    if not targets:
        raise RuntimeError("phone did not provide a private LAN or Tailscale address")

    CONFIG_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
    TOKEN_FILE.write_text(token + "\n", encoding="ascii")
    TOKEN_FILE.chmod(0o600)
    CERTIFICATE_FILE.write_text(ssl.DER_cert_to_PEM_cert(certificate), encoding="ascii")
    CERTIFICATE_FILE.chmod(0o600)
    atomic_json(
        PHONE_FILE,
        {
            "version": 1,
            "name": str(result.get("device_name") or "Android phone")[:120],
            "port": PORT,
            "targets": targets,
            "certificate_sha256": hashlib.sha256(certificate).hexdigest(),
            "paired_at": int(time.time()),
        },
    )


def pair(args):
    host = choose_phone(args.host)
    if not host:
        raise RuntimeError("a phone address is required")
    code = args.code or input("8-digit code shown in Codex Alert: ").strip().replace(" ", "")
    if not PAIR_CODE.fullmatch(code):
        raise RuntimeError("the pairing code must contain exactly 8 digits")
    def confirm_certificate(certificate):
        fingerprint = hashlib.sha256(certificate).hexdigest()
        readable = " ".join(
            fingerprint[index:index + 4] for index in range(0, 16, 4)
        ).upper()
        print(f"Security code: {readable}")
        if args.yes:
            return True
        confirmed = input("Does this match the security code on the phone? [Y/n] ").strip().lower()
        return confirmed in ("", "y", "yes")

    result, certificate = pair_request(host, code, confirm_certificate)
    save_pairing(host, result, certificate)
    print(f"Paired with {result.get('device_name') or 'Android phone'}.")
    test_phone()
    return 0


def test_phone():
    if not phone_configured():
        print("Phone is not paired.", file=sys.stderr)
        return 1
    event_id = f"setup-{uuid.uuid4()}"
    result = run(
        [
            str(PHONE_DELIVER),
            "--title", "Codex Alert is ready",
            "--body", "Pairing succeeded. Future Codex completions will appear here.",
            "--account", "setup",
            "--project", "Codex Alert",
            "--event-id", event_id,
        ],
        10,
    )
    if result.returncode != 0:
        print(result.stderr.strip() or "Could not queue the test alert.", file=sys.stderr)
    else:
        print("Sent a test notification to the phone.")
    return result.returncode


def test_all():
    event_id = f"setup-{uuid.uuid4()}"
    desktop = run(
        [
            str(DESKTOP_NOTIFY),
            "--title", "Codex Alert is ready",
            "--body", "Desktop completion notifications are working.",
            "--account", "setup",
            "--project", "Codex Alert",
            "--event-id", event_id,
        ],
        10,
    )
    if desktop.returncode == 0:
        print("Sent a test notification to the desktop.")
    else:
        print(desktop.stderr.strip() or "Desktop notification failed.", file=sys.stderr)
    phone_result = test_phone() if phone_configured() else 0
    return 0 if desktop.returncode == 0 and phone_result == 0 else 1


def status():
    homes = codex_homes()
    configured = sum((home / "hooks.json").is_file() for home in homes)
    print(f"Desktop hooks: {configured}/{len(homes)} Codex profiles")
    print(f"Phone: {phone().get('name', 'not paired') if phone_configured() else 'not paired'}")
    print(f"T3 Code integration: {'on' if settings().get('t3_integration') is True else 'off'}")
    if PHONE_DELIVER.exists() and phone_configured():
        result = run([str(PHONE_DELIVER), "status"], 10)
        if result.stdout:
            print("\n" + result.stdout.strip())
    return 0


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    subparsers = parser.add_subparsers(dest="command", required=True)
    setup_parser = subparsers.add_parser("setup", help="configure every local Codex profile")
    setup_parser.add_argument("--quiet", action="store_true")
    pair_parser = subparsers.add_parser("pair", help="pair an Android phone")
    pair_parser.add_argument("--host", help="phone IP or .local name")
    pair_parser.add_argument("--code", help="8-digit code shown by the Android app")
    pair_parser.add_argument("--yes", action="store_true", help="skip fingerprint confirmation")
    subparsers.add_parser("status", help="show configuration and delivery status")
    subparsers.add_parser("test", help="send test notifications")
    t3_parser = subparsers.add_parser("t3", help="enable or disable optional T3 Code routing")
    t3_parser.add_argument("state", choices=("on", "off"))
    args = parser.parse_args()

    try:
        if args.command == "setup":
            return sync_hooks(args.quiet)
        if args.command == "pair":
            return pair(args)
        if args.command == "status":
            return status()
        if args.command == "test":
            return test_all()
        if args.command == "t3":
            set_t3_enabled(args.state == "on")
            print(f"T3 Code integration is now {args.state}.")
            return 0
    except (OSError, RuntimeError, subprocess.TimeoutExpired) as exc:
        print(f"Error: {exc}", file=sys.stderr)
        return 1
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
