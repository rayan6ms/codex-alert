PORT = 24601
HOOK_COMMAND = str(Path.home() / ".local/bin/codex-notify-stop")
PHONE_DELIVER = Path.home() / ".local/bin/codex-phone-deliver"
DESKTOP_NOTIFY = Path.home() / ".local/bin/codex-notify-stop-desktop"
PAIR_CODE = re.compile(r"[0-9]{8}")
WATCH_LOCK = Path.home() / ".local/state/codex-notify/account-watch.lock"
HOOK_TRUST_CACHE = Path.home() / ".local/state/codex-notify/hook-trust-cache.json"
WATCH_INTERVAL_SECONDS = 5 * 60
RPC_TIMEOUT_SECONDS = 10


def run(command, timeout=10):
    return subprocess.run(
        command,
        check=False,
        timeout=timeout,
        capture_output=True,
        text=True,
    )


def codex_binary():
    configured = os.environ.get("CODEX_ALERT_CODEX_BIN")
    if configured:
        return configured
    discovered = shutil.which("codex")
    if discovered:
        return discovered
    user_install = Path.home() / ".local/bin/codex"
    if user_install.is_file() and os.access(user_install, os.X_OK):
        return str(user_install)
    return None


def hook_definition():
    return {
        "hooks": [
            {
                "type": "command",
                "command": HOOK_COMMAND,
                "timeout": 5,
            }
        ]
    }


def is_codex_alert_hook(value):
    if not isinstance(value, dict):
        return False
    command = str(value.get("command") or "")
    return "codex-notify-stop" in command or "codex-alert hook" in command


def hook_target(path):
    """Return the shared file behind a hook symlink without replacing the link."""
    if not path.is_symlink():
        return path
    try:
        target = path.resolve(strict=True)
    except OSError as exc:
        raise RuntimeError(f"cannot safely update dangling hook symlink {path}: {exc}") from exc
    if not target.is_file():
        raise RuntimeError(f"hook symlink {path} does not point to a regular file")
    return target


def file_signature(path):
    try:
        status = path.stat()
        return status.st_dev, status.st_ino, status.st_size, status.st_mtime_ns
    except FileNotFoundError:
        return None


def sync_hook_file(path):
    target = hook_target(path)
    original_signature = file_signature(target)
    try:
        source = target.read_text(encoding="utf-8") if original_signature else ""
        value = json.loads(source) if source else {}
    except (OSError, ValueError) as exc:
        raise RuntimeError(f"cannot safely update invalid JSON in {path}: {exc}") from exc
    if not isinstance(value, dict):
        raise RuntimeError(f"cannot safely update non-object JSON in {path}")

    hooks = value.setdefault("hooks", {})
    if not isinstance(hooks, dict):
        raise RuntimeError(f"cannot safely update invalid hooks in {path}")
    stop = hooks.setdefault("Stop", [])
    if not isinstance(stop, list):
        raise RuntimeError(f"cannot safely update invalid Stop hooks in {path}")

    # Keep our hook in a dedicated, match-all group. This makes its behavior and
    # Codex trust identity deterministic while preserving every unrelated hook.
    cleaned_stop = []
    for group in stop:
        if not isinstance(group, dict) or not isinstance(group.get("hooks"), list):
            cleaned_stop.append(group)
            continue
        retained = [entry for entry in group["hooks"] if not is_codex_alert_hook(entry)]
        if retained:
            group["hooks"] = retained
            cleaned_stop.append(group)
        elif not any(is_codex_alert_hook(entry) for entry in group["hooks"]):
            cleaned_stop.append(group)
    cleaned_stop.append(hook_definition())
    hooks["Stop"] = cleaned_stop

    rendered = json.dumps(value, indent=2) + "\n"
    if source == rendered:
        return False

    target.parent.mkdir(parents=True, exist_ok=True)
    temporary = target.with_name(f"{target.name}.{os.getpid()}.tmp")
    try:
        temporary.write_text(rendered, encoding="utf-8")
        temporary.chmod(0o600)
        if file_signature(target) != original_signature:
            raise RuntimeError(f"hooks changed while Codex Alert was updating {target}; retrying later")
        temporary.replace(target)
    finally:
        temporary.unlink(missing_ok=True)
    return True


def hook_file_configured(path):
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
        return any(
            is_codex_alert_hook(hook)
            for group in value.get("hooks", {}).get("Stop", [])
            if isinstance(group, dict)
            for hook in group.get("hooks", [])
        )
    except (AttributeError, OSError, TypeError, ValueError):
        return False


class CodexAppServer:
    """Small JSONL client for Codex's authoritative hook catalog/config APIs."""

    def __init__(self, home):
        binary = codex_binary()
        if not binary:
            raise RuntimeError("Codex CLI is unavailable; cannot verify completion-hook trust")
        environment = os.environ.copy()
        environment["CODEX_HOME"] = str(home)
        self.process = subprocess.Popen(
            [binary, "app-server", "--stdio"],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            bufsize=0,
            env=environment,
            start_new_session=True,
        )
        self.next_id = 1
        self.output_buffer = b""
        try:
            self.request(
                "initialize",
                {
                    "clientInfo": {
                        "name": "codex_alert",
                        "title": "Codex Alert",
                        "version": "1",
                    },
                    "capabilities": {"experimentalApi": True},
                },
            )
            self.notify("initialized", {})
        except Exception:
            self.close()
            raise

    def send(self, message):
        if self.process.stdin is None:
            raise RuntimeError("Codex app server input is unavailable")
        encoded = (json.dumps(message, separators=(",", ":")) + "\n").encode("utf-8")
        self.process.stdin.write(encoded)
        self.process.stdin.flush()

    def notify(self, method, params):
        self.send({"method": method, "params": params})

    def request(self, method, params):
        request_id = self.next_id
        self.next_id += 1
        self.send({"method": method, "id": request_id, "params": params})
        deadline = time.monotonic() + RPC_TIMEOUT_SECONDS
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise RuntimeError(f"Codex app server timed out during {method}")
            if self.process.stdout is None:
                raise RuntimeError("Codex app server output is unavailable")
            while b"\n" not in self.output_buffer:
                readable, _, _ = select.select([self.process.stdout], [], [], remaining)
                if not readable:
                    raise RuntimeError(f"Codex app server timed out during {method}")
                chunk = os.read(self.process.stdout.fileno(), 65536)
                if not chunk:
                    raise RuntimeError(f"Codex app server closed during {method}")
                self.output_buffer += chunk
                remaining = deadline - time.monotonic()
                if remaining <= 0 and b"\n" not in self.output_buffer:
                    raise RuntimeError(f"Codex app server timed out during {method}")
            line, self.output_buffer = self.output_buffer.split(b"\n", 1)
            try:
                response = json.loads(line)
            except (UnicodeDecodeError, ValueError):
                continue
            if response.get("id") != request_id:
                continue
            if "error" in response:
                error = response["error"]
                message = error.get("message") if isinstance(error, dict) else str(error)
                raise RuntimeError(f"Codex app server rejected {method}: {message}")
            return response.get("result", {})

    def close(self):
        if self.process.stdin is not None:
            try:
                self.process.stdin.close()
            except OSError:
                pass
        try:
            self.process.wait(timeout=2)
        except subprocess.TimeoutExpired:
            self.process.terminate()
            try:
                self.process.wait(timeout=2)
            except subprocess.TimeoutExpired:
                self.process.kill()
                self.process.wait(timeout=2)
        if self.process.stdout is not None:
            self.process.stdout.close()

    def __enter__(self):
        return self

    def __exit__(self, _type, _value, _traceback):
        self.close()


def config_target(home):
    path = home / "config.toml"
    try:
        return path.resolve(strict=path.is_symlink())
    except OSError as exc:
        raise RuntimeError(f"cannot safely resolve Codex config {path}: {exc}") from exc


def homes_by_config(homes):
    groups = {}
    for home in homes:
        groups.setdefault(config_target(home), []).append(home)
    return groups


def codex_alert_hook_metadata(client, home):
    result = client.request("hooks/list", {"cwds": [str(Path.cwd())]})
    entries = result.get("data", [])
    if not entries:
        raise RuntimeError(f"Codex returned no hook catalog for {home}")
    catalog = entries[0]
    errors = catalog.get("errors") or []
    if errors:
        message = errors[0].get("message") if isinstance(errors[0], dict) else str(errors[0])
        raise RuntimeError(f"Codex could not load hooks for {home}: {message}")
    expected_source = str(home / "hooks.json")
    matches = [
        hook
        for hook in catalog.get("hooks", [])
        if hook.get("handlerType") == "command"
        and hook.get("command") == HOOK_COMMAND
        and hook.get("sourcePath") == expected_source
    ]
    if len(matches) != 1:
        raise RuntimeError(f"Codex did not discover exactly one Codex Alert hook for {home}")
    return matches[0]


def hook_state(config_path, key):
    try:
        value = tomllib.loads(config_path.read_text(encoding="utf-8"))
        state = value.get("hooks", {}).get("state", {}).get(key, {})
        return state if isinstance(state, dict) else {}
    except (AttributeError, OSError, TypeError, ValueError):
        return {}


def group_hook_keys(homes, representative, metadata):
    keys = {home: configured_hook_key(home) for home in homes}
    if keys[representative] != metadata.get("key"):
        raise RuntimeError(f"Codex returned an unexpected hook key for {representative}")
    return keys


def configured_hook_key(home):
    path = home / "hooks.json"
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
        matches = [
            f"{path}:stop:{group_index}:{handler_index}"
            for group_index, group in enumerate(value.get("hooks", {}).get("Stop", []))
            if isinstance(group, dict)
            for handler_index, hook in enumerate(group.get("hooks", []))
            if is_codex_alert_hook(hook)
        ]
    except (AttributeError, OSError, TypeError, ValueError) as exc:
        raise RuntimeError(f"cannot determine Codex Alert hook key in {path}: {exc}") from exc
    if len(matches) != 1:
        raise RuntimeError(f"expected exactly one Codex Alert hook in {path}")
    return matches[0]


def path_identity(path):
    try:
        resolved = path.resolve(strict=True)
        signature = file_signature(resolved)
        return [str(resolved), *signature] if signature else None
    except OSError:
        return None


def codex_binary_identity():
    binary = codex_binary()
    return path_identity(Path(binary)) if binary else None


def hook_source_identities(homes):
    return {str(home): path_identity(home / "hooks.json") for home in homes}


def hook_trust_cache_valid(homes):
    cache = load_json(HOOK_TRUST_CACHE)
    if cache.get("version") != 1:
        return False
    if cache.get("codex_binary") != codex_binary_identity():
        return False
    if cache.get("hook_sources") != hook_source_identities(homes):
        return False
    entries = cache.get("entries")
    if not isinstance(entries, list) or len(entries) != len(homes):
        return False
    expected_homes = {str(home) for home in homes}
    if {entry.get("home") for entry in entries if isinstance(entry, dict)} != expected_homes:
        return False
    for entry in entries:
        if not isinstance(entry, dict):
            return False
        current_hash = entry.get("current_hash")
        config = entry.get("config")
        key = entry.get("key")
        if not isinstance(config, str) or not config or not isinstance(key, str) or not key:
            return False
        state = hook_state(Path(config), key)
        if (
            not isinstance(current_hash, str)
            or state.get("trusted_hash") != current_hash
            or state.get("enabled") is False
        ):
            return False
    return True


def save_hook_trust_cache(homes, entries):
    atomic_json(HOOK_TRUST_CACHE, {
        "version": 1,
        "codex_binary": codex_binary_identity(),
        "hook_sources": hook_source_identities(homes),
        "entries": entries,
    })


def inspect_hook_trust(homes):
    """Return (trusted homes, total homes, issues) using Codex's live hook catalog."""
    trusted = 0
    issues = []
    for config_path, group in homes_by_config(homes).items():
        representative = group[0]
        try:
            with CodexAppServer(representative) as client:
                metadata = codex_alert_hook_metadata(client, representative)
            current_hash = metadata.get("currentHash")
            keys = group_hook_keys(group, representative, metadata)
            for home, key in keys.items():
                state = hook_state(config_path, key)
                if (
                    current_hash
                    and state.get("trusted_hash") == current_hash
                    and state.get("enabled") is not False
                ):
                    trusted += 1
                else:
                    issues.append(f"completion hook is not trusted and enabled for {home}")
        except RuntimeError as exc:
            issues.append(str(exc))
    return trusted, len(homes), issues


def ensure_hook_trust(homes):
    """Trust and enable only the exact completion hook installed by Codex Alert."""
    trusted = 0
    failures = []
    cache_entries = []
    for config_path, group in homes_by_config(homes).items():
        representative = group[0]
        try:
            with CodexAppServer(representative) as client:
                metadata = codex_alert_hook_metadata(client, representative)
                current_hash = metadata.get("currentHash")
                if not isinstance(current_hash, str) or not current_hash.startswith("sha256:"):
                    raise RuntimeError(f"Codex returned an invalid hook hash for {representative}")
                keys = group_hook_keys(group, representative, metadata)
                updates = {}
                for key in keys.values():
                    state = hook_state(config_path, key)
                    if state.get("trusted_hash") != current_hash or state.get("enabled") is False:
                        updates[key] = {"trusted_hash": current_hash, "enabled": True}
                if updates:
                    client.request(
                        "config/batchWrite",
                        {
                            "edits": [{
                                "keyPath": "hooks.state",
                                "value": updates,
                                "mergeStrategy": "upsert",
                            }],
                            "reloadUserConfig": True,
                        },
                    )
                verified = codex_alert_hook_metadata(client, representative)
                if verified.get("trustStatus") != "trusted" or verified.get("enabled") is not True:
                    raise RuntimeError(f"Codex did not activate the completion hook for {representative}")
            for home, key in keys.items():
                state = hook_state(config_path, key)
                if state.get("trusted_hash") == current_hash and state.get("enabled") is not False:
                    trusted += 1
                    cache_entries.append({
                        "home": str(home),
                        "config": str(config_path),
                        "key": key,
                        "current_hash": current_hash,
                    })
                else:
                    failures.append(f"completion hook state was not saved for {key}")
        except RuntimeError as exc:
            failures.append(str(exc))
    if not failures and trusted == len(homes):
        save_hook_trust_cache(homes, cache_entries)
    else:
        HOOK_TRUST_CACHE.unlink(missing_ok=True)
    return trusted, failures


def sync_hooks(quiet=False):
    homes = codex_homes()
    failures = []
    shared_targets = {}
    for home in homes:
        try:
            hook_path = home / "hooks.json"
            target = hook_target(hook_path)
            identity = target.resolve(strict=False)
            shared_targets.setdefault(identity, hook_path)
        except RuntimeError as exc:
            failures.append(str(exc))
    for hook_path in shared_targets.values():
        try:
            sync_hook_file(hook_path)
        except RuntimeError as exc:
            failures.append(str(exc))
    trusted = 0
    if not failures and quiet and hook_trust_cache_valid(homes):
        trusted = len(homes)
    elif not failures:
        trusted, trust_failures = ensure_hook_trust(homes)
        failures.extend(trust_failures)
    if not quiet:
        configured = sum(hook_file_configured(home / "hooks.json") for home in homes)
        print(f"Configured {configured} authenticated Codex account(s); {trusted} active completion hook(s).")
    for failure in failures:
        print(f"Warning: {failure}", file=sys.stderr)
    return 1 if failures else 0


def watch_hooks():
    """Keep account discovery available on desktops without a systemd user manager."""
    WATCH_LOCK.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    with WATCH_LOCK.open("a+", encoding="utf-8") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return 0
        while True:
            sync_hooks(quiet=True)
            time.sleep(WATCH_INTERVAL_SECONDS)


def discover_phones():
    binary = shutil.which("avahi-browse")
    if not binary:
        return []
    result = run([binary, "--resolve", "--terminate", "--parsable", "_codexalert._tcp"], 5)
    if result.returncode != 0:
        return []
    found = []
    seen = set()
    for line in result.stdout.splitlines():
        fields = line.split(";")
        if len(fields) < 9 or fields[0] != "=" or fields[2] != "IPv4":
            continue
        name = decode_avahi_field(fields[3].strip())
        host, port = fields[7].strip(), fields[8].strip()
        if host and port == str(PORT) and host not in seen:
            seen.add(host)
            found.append((name or "Android phone", host))
    return found


def decode_avahi_field(value):
    """Decode Avahi's decimal byte escapes and then interpret the result as UTF-8."""
    decoded = bytearray()
    index = 0
    while index < len(value):
        if value[index] == "\\" and value[index + 1:index + 4].isdigit():
            escaped = int(value[index + 1:index + 4])
            if escaped <= 255:
                decoded.append(escaped)
                index += 4
                continue
        decoded.extend(value[index].encode("utf-8"))
        index += 1
    return decoded.decode("utf-8", errors="replace")


def choose_phone(explicit_host=None):
    if explicit_host:
        return explicit_host
    phones = discover_phones()
    if len(phones) == 1:
        print(f"Found {phones[0][0]} at {phones[0][1]}.")
        return phones[0][1]
    if len(phones) > 1:
        print("Found multiple phones:")
        for index, (name, host) in enumerate(phones, 1):
            print(f"  {index}. {name} · {host}")
        while True:
            choice = input("Choose a phone: ").strip()
            if choice.isdigit() and 1 <= int(choice) <= len(phones):
                return phones[int(choice) - 1][1]
    return input("Phone address shown in Codex Alert: ").strip()


def pair_request(host, code, confirm_certificate):
    context = ssl._create_unverified_context()
    context.minimum_version = ssl.TLSVersion.TLSv1_2
    payload = json.dumps({"code": code}, separators=(",", ":")).encode("utf-8")
    certificate = None
    last_error = None
    transient_errors = (
        http.client.RemoteDisconnected,
        ConnectionResetError,
        BrokenPipeError,
        ssl.SSLError,
        socket.timeout,
    )
    for attempt in range(3):
        connection = http.client.HTTPSConnection(host, PORT, timeout=8, context=context)
        try:
            connection.connect()
            current_certificate = connection.sock.getpeercert(binary_form=True)
            if certificate is None:
                if not confirm_certificate(current_certificate):
                    raise RuntimeError("pairing cancelled; security codes did not match")
                certificate = current_certificate
            elif not hmac.compare_digest(certificate, current_certificate):
                raise RuntimeError("phone identity changed while retrying; pairing cancelled")
            connection.request(
                "POST",
                "/v1/pair",
                body=payload,
                headers={
                    "Content-Type": "application/json",
                    "Content-Length": str(len(payload)),
                    "Connection": "close",
                },
            )
            response = connection.getresponse()
            body = response.read(8192).decode("utf-8", errors="replace")
            try:
                result = json.loads(body)
            except ValueError as exc:
                raise RuntimeError(
                    f"phone returned an invalid response (HTTP {response.status})"
                ) from exc
            if response.status != 200 or result.get("status") != "paired":
                raise RuntimeError(
                    str(result.get("message") or result.get("status") or response.status)
                )
            return result, certificate
        except transient_errors as exc:
            last_error = exc
            if attempt < 2:
                time.sleep(0.25 * (attempt + 1))
        finally:
            connection.close()
    raise RuntimeError(
        "phone closed the connection before returning pairing credentials; "
        "the request was retried safely"
    ) from last_error


def confirm_pairing(host, token, certificate):
    """Prove to the phone that the desktop received its credentials."""
    context = ssl._create_unverified_context()
    context.minimum_version = ssl.TLSVersion.TLSv1_2
    last_error = None
    transient_errors = (
        http.client.RemoteDisconnected,
        ConnectionResetError,
        BrokenPipeError,
        ssl.SSLError,
        socket.timeout,
    )
    for attempt in range(3):
        connection = http.client.HTTPSConnection(host, PORT, timeout=8, context=context)
        try:
            connection.connect()
            current_certificate = connection.sock.getpeercert(binary_form=True)
            if not hmac.compare_digest(certificate, current_certificate):
                raise RuntimeError("phone identity changed before pairing confirmation")
            connection.request(
                "POST",
                "/v1/pair/confirm",
                body=b"",
                headers={
                    "Authorization": f"Bearer {token}",
                    "Content-Length": "0",
                    "Connection": "close",
                },
            )
            response = connection.getresponse()
            body = response.read(8192).decode("utf-8", errors="replace")
            try:
                result = json.loads(body)
            except ValueError as exc:
                raise RuntimeError(
                    f"phone returned an invalid confirmation (HTTP {response.status})"
                ) from exc
            if response.status != 200 or result.get("status") != "paired":
                raise RuntimeError(str(result.get("status") or response.status))
            return
        except transient_errors as exc:
            last_error = exc
            if attempt < 2:
                time.sleep(0.25 * (attempt + 1))
        finally:
            connection.close()
    raise RuntimeError("phone did not acknowledge pairing confirmation") from last_error


def private_target(value):
    try:
        address = ipaddress.ip_address(value)
        private_networks = (
            ipaddress.ip_network("10.0.0.0/8"),
            ipaddress.ip_network("172.16.0.0/12"),
            ipaddress.ip_network("192.168.0.0/16"),
            ipaddress.ip_network("100.64.0.0/10"),
            ipaddress.ip_network("fd7a:115c:a1e0::/48"),
        )
        return any(address in network for network in private_networks)
    except ValueError:
        return value.endswith(".local")


def save_pairing(host, result, certificate):
    token = str(result.get("token") or "")
    if not re.fullmatch(r"[0-9a-f]{64}", token):
        raise RuntimeError("phone returned an invalid delivery token")
    targets = []
    for candidate in [host, *(result.get("addresses") or [])]:
        candidate = str(candidate).strip().split("%", 1)[0]
        if candidate and private_target(candidate) and candidate not in targets:
            targets.append(candidate)
    if not targets:
        raise RuntimeError("phone did not provide a private LAN or Tailscale address")

    CONFIG_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
    TOKEN_FILE.write_text(token + "\n", encoding="ascii")
    TOKEN_FILE.chmod(0o600)
    CERTIFICATE_FILE.write_text(ssl.DER_cert_to_PEM_cert(certificate), encoding="ascii")
    CERTIFICATE_FILE.chmod(0o600)
    atomic_json(
        PHONE_FILE,
        {
            "version": 1,
            "name": str(result.get("device_name") or "Android phone")[:120],
            "port": PORT,
            "targets": targets,
            "certificate_sha256": hashlib.sha256(certificate).hexdigest(),
            "paired_at": int(time.time()),
        },
    )


def pair(args):
    host = choose_phone(args.host)
    if not host:
        raise RuntimeError("a phone address is required")
    code = args.code or input("8-digit code shown in Codex Alert: ").strip().replace(" ", "")
    if not PAIR_CODE.fullmatch(code):
        raise RuntimeError("the pairing code must contain exactly 8 digits")
    def confirm_certificate(certificate):
        fingerprint = hashlib.sha256(certificate).hexdigest()
        readable = " ".join(
            fingerprint[index:index + 4] for index in range(0, 16, 4)
        ).upper()
        print(f"Security code: {readable}")
        confirmed = input(
            "Compare it with the phone, then type yes to continue: "
        ).strip().lower()
        return confirmed == "yes"

    result, certificate = pair_request(host, code, confirm_certificate)
    save_pairing(host, result, certificate)
    confirm_pairing(host, str(result["token"]), certificate)
    print(f"Paired with {result.get('device_name') or 'Android phone'}.")
    test_phone()
    return 0


def test_phone():
    if not phone_configured():
        print("Phone is not paired.", file=sys.stderr)
        return 1
    event_id = f"setup-{uuid.uuid4()}"
    result = run(
        [
            str(PHONE_DELIVER),
            "--title", "Codex Alert is ready",
            "--body", "Pairing succeeded. Future Codex completions will appear here.",
            "--account", "setup",
            "--project", "Codex Alert",
            "--event-id", event_id,
        ],
        10,
    )
    if result.returncode != 0:
        print(result.stderr.strip() or "Could not queue the test alert.", file=sys.stderr)
    else:
        print("Queued a test notification for the phone; delivery retries automatically.")
    return result.returncode


def test_all():
    event_id = f"setup-{uuid.uuid4()}"
    desktop = run(
        [
            str(DESKTOP_NOTIFY),
            "--title", "Codex Alert is ready",
            "--body", "Desktop completion notifications are working.",
            "--account", "setup",
            "--project", "Codex Alert",
            "--event-id", event_id,
        ],
        10,
    )
    if desktop.returncode == 0:
        print("Sent a test notification to the desktop.")
    else:
        print(desktop.stderr.strip() or "Desktop notification failed.", file=sys.stderr)
    phone_result = test_phone() if phone_configured() else 0
    return 0 if desktop.returncode == 0 and phone_result == 0 else 1


def status():
    homes = codex_homes()
    configured = sum(hook_file_configured(home / "hooks.json") for home in homes)
    trusted, total, issues = inspect_hook_trust(homes) if homes else (0, 0, [])
    print(f"Desktop hooks: {trusted}/{total} active ({configured}/{len(homes)} configured)")
    for issue in issues:
        print(f"  Warning: {issue}")
    print(
        "Desktop notifications: "
        + ("freedesktop.org service" if shutil.which("notify-send") else "unavailable (notify-send missing)")
    )
    print(f"Phone: {phone().get('name', 'not paired') if phone_configured() else 'not paired'}")
    print(f"T3 Code integration: {'on' if settings().get('t3_integration') is True else 'off'}")
    if PHONE_DELIVER.exists() and phone_configured():
        result = run([str(PHONE_DELIVER), "status"], 10)
        if result.stdout:
            print("\n" + result.stdout.strip())
    return 0


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    subparsers = parser.add_subparsers(dest="command", required=True)
    setup_parser = subparsers.add_parser("setup", help="configure every local Codex profile")
    setup_parser.add_argument("--quiet", action="store_true")
    pair_parser = subparsers.add_parser("pair", help="pair an Android phone")
    pair_parser.add_argument("--host", help="phone IP or .local name")
    pair_parser.add_argument("--code", help="8-digit code shown by the Android app")
    subparsers.add_parser("status", help="show configuration and delivery status")
    subparsers.add_parser("test", help="send test notifications")
    subparsers.add_parser("watch", help=argparse.SUPPRESS)
    t3_parser = subparsers.add_parser("t3", help="enable or disable optional T3 Code routing")
    t3_parser.add_argument("state", choices=("on", "off"))
    args = parser.parse_args()

    try:
        if args.command == "setup":
            return sync_hooks(args.quiet)
        if args.command == "pair":
            return pair(args)
        if args.command == "status":
            return status()
        if args.command == "test":
            return test_all()
        if args.command == "watch":
            return watch_hooks()
        if args.command == "t3":
            set_t3_enabled(args.state == "on")
            print(f"T3 Code integration is now {args.state}.")
            return 0
    except (OSError, RuntimeError, subprocess.TimeoutExpired) as exc:
        print(f"Error: {exc}", file=sys.stderr)
        return 1
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
